{
  "name": "@creno/react",
  "version": "0.1.1",
  "description": "Themeable React booking widget for Creno (https://crenoapp.com): real-time availability, service-type menus, and optional Cloudflare Turnstile bot protection.",
  "license": "MIT",
  "keywords": ["booking", "scheduling", "appointment-scheduling", "react", "calendar", "api-client"],
  "homepage": "https://crenoapp.com/docs",
  "repository": { "type": "git", "url": "https://github.com/whythoughts/creno-react.git" },
  "bugs": "https://github.com/whythoughts/creno-react/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./style.css": "./dist/widget.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "luxon": "^3.5.0",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/react": "^18.3.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
